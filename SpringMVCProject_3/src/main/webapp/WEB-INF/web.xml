<?xml version="1.0" encoding="UTF-8"?>
<web-app version="2.5" xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee https://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">

    <!-- 
       톰캣 = 구동
             Servlet
       사용자 요청
          DispatcherServlet 호출
               | 위임
          HandlerMapping
               | @Controller / @RestController
                   => GetMapping / PostMapping / RequestMapping
                   => RequestMapping = GetMapping + PostMapping
            메소드 호출
               | 요청 처리 = 데이터연동 / Open API / 크롤링
                 화면에 출력할 데이터 모아줌
                 request / session
                 ======= 클래스화 (전송 객체 = Model)
          DispatcherServlet
               | JSP를 찾는다
            ViewResolver
               | JSP에 request/session에 담긴 데이터 전송
              JSP
               
         1. public class DispatcherServlet extends HttpServlet
            {
                // 가장 먼저 호출되는 함수 
                public void init(ServletConfig config)
                {
                   XML 설정파일 읽기
                   String xml=config.getInitParameter("contextConfigLocation");  
                }
                public void service(HttpServletRequest request,HttpServletResponse response)
                {
                  // 없는 경우 => default xml을 읽어온다
                  dispatcher-servlet.xml
                  ========== <servlet-name>
                  <servlet-name>aaa</servlet-name> 
                  aaa-servlet.xml
                }
            }
            
            DispatcherServlet
                 | = HandlerMapping : 메소드 찾기 => @Controller / @RestController 
                 | = ViewResolver : JSP를 찾아서 request전송  
                 | = WebApplicationContext : 클래스 관리자 
                
       
     -->
	 <servlet>
		<servlet-name>dispatcher</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<init-param>
			<param-name>contextConfigLocation</param-name>
			<param-value>/WEB-INF/config/application-*.xml</param-value>
		</init-param>		
	</servlet>
		
	<servlet-mapping>
		<servlet-name>dispatcher</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
    
     <filter>
		<filter-name>encodingFilter</filter-name>
		<filter-class>
			org.springframework.web.filter.CharacterEncodingFilter
		</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
	</filter>

	<filter-mapping>
		<filter-name>encodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	
</web-app>
